NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nis
JWT_SECRET=change-this-to-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Use uma vez com `npm run bootstrap` para criar o primeiro administrador.
BOOTSTRAP_TENANT_NAME=Farmácia Clínica Estácio FMJ
BOOTSTRAP_ADMIN_EMAIL=admin@estacio.br
BOOTSTRAP_ADMIN_PASSWORD=Estacio@2026!
